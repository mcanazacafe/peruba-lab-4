                  "pm.test('Swagger UI disponible', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/docs",
              "host": ["{{base_url}}"],
              "path": ["docs"]
            },
            "description": "Accede a la documentación interactiva Swagger UI generada por FastAPI."
          }
        },
        {
          "name": "GET /redoc - ReDoc",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('ReDoc disponible', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/redoc",
              "host": ["{{base_url}}"],
              "path": ["redoc"]
            },
            "description": "Accede a la documentación ReDoc."
          }
        },
        {
          "name": "GET /openapi.json - OpenAPI Schema",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Schema contiene rutas esperadas', function () {",
                  "    var schema = pm.response.json();",
                  "    pm.expect(schema.paths).to.have.property('/');",
                  "    pm.expect(schema.paths).to.have.property('/analyze-image');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/openapi.json",
              "host": ["{{base_url}}"],
              "path": ["openapi.json"]
            },
            "description": "Obtiene el schema OpenAPI 3.x generado automáticamente por FastAPI."
          }
        }
      ]
    }
  ]
}
